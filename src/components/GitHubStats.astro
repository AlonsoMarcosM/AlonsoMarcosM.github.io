---
import Icon from './Icon.astro';
import { Icon as Iconify } from 'astro-icon/components';

interface Props {
  username: string;
  lang: 'es' | 'en';
}

interface GitHubProfile {
  public_repos: number;
}

interface GitHubRepository {
  fork: boolean;
  language: string | null;
  pushed_at: string | null;
}

const { username, lang } = Astro.props;
const tt = (es: string, en: string) => (lang === 'es' ? es : en);
const githubHeaders = {
  Accept: 'application/vnd.github+json',
  'User-Agent': 'AlonsoMarcosM-portfolio',
};

let profile: GitHubProfile | null = null;
let repositories: GitHubRepository[] = [];

try {
  const [profileResponse, repositoriesResponse] = await Promise.all([
    fetch(`https://api.github.com/users/${username}`, { headers: githubHeaders }),
    fetch(`https://api.github.com/users/${username}/repos?per_page=100&type=owner&sort=updated`, {
      headers: githubHeaders,
    }),
  ]);

  if (!profileResponse.ok || !repositoriesResponse.ok) {
    throw new Error(`GitHub API returned ${profileResponse.status}/${repositoriesResponse.status}`);
  }

  profile = (await profileResponse.json()) as GitHubProfile;
  repositories = (await repositoriesResponse.json()) as GitHubRepository[];
} catch (error) {
  console.warn('GitHub snapshot could not be generated:', error);
}

const ownRepositories = repositories.filter((repository) => !repository.fork);
const languageCounts = ownRepositories.reduce<Record<string, number>>((counts, repository) => {
  if (repository.language) counts[repository.language] = (counts[repository.language] ?? 0) + 1;
  return counts;
}, {});
const languages = Object.entries(languageCounts)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 6);
const maxLanguageCount = Math.max(...languages.map(([, count]) => count), 1);
const latestPush = ownRepositories
  .map((repository) => repository.pushed_at)
  .filter((date): date is string => Boolean(date))
  .sort()
  .at(-1);
const snapshotAvailable = profile !== null && repositories.length > 0;
const dateFormatter = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
const latestActivity = latestPush ? dateFormatter.format(new Date(latestPush)) : '—';
---

<div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white/60 p-6 backdrop-blur sm:p-8 dark:border-slate-800 dark:bg-slate-900/40">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand-400 via-accent-500 to-blue-500"></div>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-emerald-600 dark:text-emerald-300">
        <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        {tt('Datos oficiales de GitHub', 'Official GitHub data')}
      </span>
      <h2 class="mt-3 flex items-center gap-2 text-2xl font-bold tracking-tight sm:text-3xl">
        <Iconify name="lucide:activity" class="h-6 w-6 text-brand-500" />
        {tt('Estadísticas de código', 'Coding stats')}
      </h2>
      <p class="mt-1 text-slate-500 dark:text-slate-400">
        {tt('Snapshot actualizado en cada despliegue desde la API de GitHub.', 'Snapshot refreshed on every deployment from the GitHub API.')}
      </p>
    </div>
    <a
      href={`https://github.com/${username}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex flex-none items-center gap-2 rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold transition hover:border-brand-400 hover:text-brand-500 dark:border-slate-700"
    >
      <Icon name="github" class="h-4 w-4" />
      {tt('Abrir perfil de GitHub', 'Open GitHub profile')}
      <Iconify name="lucide:arrow-up-right" class="h-4 w-4" />
    </a>
  </div>

  {snapshotAvailable ? (
    <div class="mt-6 grid gap-4 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
        <div class="rounded-2xl border border-slate-200/70 bg-white/50 p-5 dark:border-slate-800 dark:bg-slate-900/40">
          <p class="text-3xl font-bold text-slate-900 dark:text-white">{profile?.public_repos ?? ownRepositories.length}</p>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{tt('Repositorios públicos', 'Public repositories')}</p>
        </div>
        <div class="rounded-2xl border border-slate-200/70 bg-white/50 p-5 dark:border-slate-800 dark:bg-slate-900/40">
          <p class="text-3xl font-bold text-slate-900 dark:text-white">{languages.length}</p>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{tt('Lenguajes principales', 'Primary languages')}</p>
        </div>
        <div class="rounded-2xl border border-slate-200/70 bg-white/50 p-5 dark:border-slate-800 dark:bg-slate-900/40">
          <p class="text-xl font-bold text-slate-900 dark:text-white">{latestActivity}</p>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{tt('Última actividad pública', 'Latest public activity')}</p>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200/70 bg-white/50 p-5 dark:border-slate-800 dark:bg-slate-900/40 sm:p-6">
        <div class="flex items-center gap-2">
          <Iconify name="lucide:code-2" class="h-5 w-5 text-brand-500" />
          <h3 class="font-semibold text-slate-900 dark:text-white">{tt('Lenguaje principal por repositorio', 'Primary language by repository')}</h3>
        </div>
        <p class="mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
          {tt('Distribución de los repositorios públicos propios con un lenguaje detectado.', 'Distribution across owned public repositories with a detected language.')}
        </p>
        <div class="mt-5 space-y-4">
          {languages.map(([language, count]) => (
            <div>
              <div class="mb-1.5 flex items-center justify-between gap-4 text-sm">
                <span class="font-medium text-slate-700 dark:text-slate-200">{language}</span>
                <span class="text-xs text-slate-500 dark:text-slate-400">{count} {count === 1 ? 'repo' : 'repos'}</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800">
                <div
                  class="h-full rounded-full bg-gradient-to-r from-brand-400 to-accent-500"
                  style={`width: ${(count / maxLanguageCount) * 100}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  ) : (
    <div class="mt-6 rounded-2xl border border-slate-200/70 bg-white/50 p-6 text-center dark:border-slate-800 dark:bg-slate-900/40">
      <Icon name="github" class="mx-auto h-7 w-7 text-brand-500" />
      <p class="mt-3 text-sm font-semibold text-slate-800 dark:text-slate-100">
        {tt('El snapshot no pudo actualizarse en este despliegue', 'The snapshot could not be refreshed for this deployment')}
      </p>
      <p class="mx-auto mt-1 max-w-lg text-xs leading-relaxed text-slate-500 dark:text-slate-400">
        {tt('Puedes consultar todos los repositorios directamente en el perfil de GitHub.', 'You can still browse every repository directly on the GitHub profile.')}
      </p>
    </div>
  )}
</div>
